{
  "name": "paris-jeu-3d",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "python scripts/generate_icons.py && tsc --noEmit && npm run test:astronomy && npm run test:street-labels && npm run test:material-catalog && npm run test:roof-geometry && npm run test:camera && vite build && python scripts/check_site_size.py dist",
    "preview": "vite preview --host 0.0.0.0",
    "test:astronomy": "node --experimental-strip-types scripts/check_astronomy.mjs",
    "test:street-labels": "node --experimental-strip-types scripts/check_street_labels.mjs",
    "test:material-catalog": "node --experimental-strip-types scripts/check_material_catalog.mjs",
    "test:roof-geometry": "node --experimental-strip-types scripts/check_roof_geometry.mjs",
    "test:camera": "node --experimental-strip-types scripts/check_camera.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "earcut": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
